# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT} # Small update to push development on Vercel

# Database (PostgreSQL / Supabase)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_DATABASE=carto_profil
# Mettre à true pour Supabase en production (connexion externe requiert SSL)
DB_SSL=false

# Session
SESSION_DRIVER=cookie