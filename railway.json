{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "node ace build && cd build && npm ci --omit=dev"
  },
  "deploy": {
    "startCommand": "cd build && node bin/server.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
